# Copy to .env and adjust. Never commit a real .env.
# Every value below is read once by app.core.config.Settings, which fails fast
# when a value is missing, malformed, or unsafe for the chosen APP_ENV.

# --- runtime ---------------------------------------------------------------
APP_ENV=development
APP_NAME=contract-expiry-notification-agent
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# Leave blank to default from APP_ENV (JSON in staging/production).
LOG_JSON=

# --- security --------------------------------------------------------------
# Must be >= 32 chars and must NOT be this placeholder in staging/production.
SECRET_KEY=dev-only-insecure-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# 32-byte url-safe base64 value. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# Keys this installation used before the current one: comma-separated, oldest
# first, at most 4. They are decrypt-only, so they exist to make rotating
# ENCRYPTION_KEY survivable rather than to be kept forever. Rotation:
#   1. move the old key here and put the new one in ENCRYPTION_KEY
#   2. restart, then run: python -m app.cli reseal-fields
#   3. when its log says rewrapped=0, clear this variable and restart again
# Empty is the steady state. Setting it without ENCRYPTION_KEY is refused at
# startup, because nothing would be able to seal the rows being re-wrapped.
ENCRYPTION_KEY_PREVIOUS=
# Argon2id cost. The defaults meet argon2-cffi's recommendation and exceed the
# OWASP minimum (19 MiB, t=2, p=1). Lowering them weakens every stored password
# hash, so change them only to climb.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
# Login admission control. Failed logins are counted per (tenant slug, email)
# digest inside a sliding window; once LOGIN_MAX_ATTEMPTS failures sit in that
# window the next attempt is refused with 429 + Retry-After *before* any password
# hashing, so a flood costs a SHA-256 and a count instead of an Argon2id run.
# 5 failures in 900s is the intended posture: room for a mistyped password, too
# few to be a useful guessing oracle. Raising the count or shortening the window
# widens the guess budget; shrinking either locks a legitimate user out for up to
# one window. The counters live in MySQL (no Redis), one row per failure.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- infrastructure --------------------------------------------------------
DATABASE_URL=mysql+pymysql://app:app@localhost:3306/contracts
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OLLAMA_BASE_URL=http://localhost:11434
# Which transport the outbox relay publishes through: none | kafka.
# `none` keeps the refusing stand-in, so events retry and then park as failed
# instead of being silently dropped — nothing is ever logged and dropped. Only
# the relay process reads this; the API never publishes. The publish timeout
# must stay below OUTBOX_LEASE_SECONDS (validated at startup).
EVENT_TRANSPORT=none
KAFKA_CLIENT_ID=contract-agent-outbox-relay
KAFKA_PUBLISH_TIMEOUT_SECONDS=10
KAFKA_PRODUCE_RETRIES=3

# --- readiness (F5) --------------------------------------------------------
# Upper bound, in seconds, on one dependency check in GET /health/ready.
# Liveness (/health) touches nothing and never uses this. It also bounds the
# Kafka admin client's request timeout: a blocked worker thread cannot be
# cancelled from outside, so the probe has to give up on its own.
READINESS_TIMEOUT_SECONDS=2

# --- extraction (F7) -------------------------------------------------------
# Which backend reads field values out of a contract document: pattern | ollama.
# `pattern` is deterministic and offline (labelled regexes). `ollama` sends the
# document text to the local model named below. There is no cloud option: "no
# cloud LLM" is a non-negotiable, so the setting cannot even name one.
EXTRACTION_BACKEND=pattern
EXTRACTION_MODEL=llama3.1:8b
EXTRACTION_TIMEOUT_SECONDS=30
# At or above this confidence a field may skip human review (0 < t <= 1). Below
# it the field is written `pending_review` and blocks the notification pipeline.
# No setting can make extraction write `approved`: only a person can.
EXTRACTION_REVIEW_THRESHOLD=0.8
# Upper bound, in characters, on the document text handed to a backend.
EXTRACTION_MAX_DOCUMENT_CHARS=20000

# --- contract documents (gap 12) -------------------------------------------
# Where uploaded document bytes are kept. Documents are sealed with
# ENCRYPTION_KEY before they are written — a PDF holds every field on the page at
# once, so a document in the clear would undo the encryption of extracted values.
# Keys are content-addressed (`<sha256[:2]>/<sha256>`), so re-uploading a file is
# one blob rather than a second copy.
# Relative is accepted in development only; staging and production must name an
# absolute path. The API, the workers and an operator's CLI do not share a
# working directory, and a disagreement there appears as a stored document that
# cannot be found.
DOCUMENT_STORE_PATH=var/documents
# Largest document accepted, in bytes (at most 100 MiB — 104857600).
# This bounds what is sealed and stored, not the memory FastAPI has already used
# to read the request body; a proxy's own body limit is the only thing that can
# bound that.
DOCUMENT_MAX_BYTES=10485760

# --- notification dispatch (F10) -------------------------------------------
# Which transport delivers a message: none | smtp.
# `none` wires a refusing stand-in, so a dispatch records the attempt and fails
# visibly (409 SENDER_UNAVAILABLE) instead of marking a row `sent` with nothing
# delivered. `smtp` selects the one adapter in the tree; there is still no SMS or
# voice gateway, so those channels refuse rather than arriving by e-mail.
NOTIFICATION_TRANSPORT=none
# --- SMTP, read only when NOTIFICATION_TRANSPORT=smtp ----------------------
# A normal return from a send means the relay ACCEPTED the message (its 250 to
# DATA), not that it was delivered: bounces arrive later and are not handled yet.
# SMTP_HOST and SMTP_FROM are required for `smtp`; missing either is a startup
# error rather than a failure discovered inside the scheduler's row lock.
SMTP_HOST=
# 587 is the submission port and expects STARTTLS. Port 465 (implicit TLS) is
# deliberately unsupported: it needs SMTP_SSL before the first byte, so both
# shapes behind one transport name is a setting deployments get wrong once.
SMTP_PORT=587
# The envelope sender (MAIL FROM / From:). A plain address — no display name.
SMTP_FROM=
# Optional, but both or neither: a relay that wants credentials needs the pair.
SMTP_USERNAME=
SMTP_PASSWORD=
# Refused as `false` in staging/production: without TLS the credentials and the
# recipient address cross the network in clear text.
SMTP_STARTTLS=true
# Path to a PEM bundle of CAs to trust INSTEAD of the system trust store. Needed
# for an internal relay with a private CA; leave empty to use the system store.
# It never disables verification: the client always checks the relay's certificate
# and hostname. Boot errors, not first-send failures, for a path that is missing,
# for a file `ssl` cannot parse (empty or truncated), and for a bundle set while
# SMTP_STARTTLS=false — a CA that is never consulted would read as "TLS on".
SMTP_CA_BUNDLE=
# Ceiling on one SMTP conversation (connect, TLS, auth, DATA), applied to the
# socket by smtplib. This is a correctness bound, not tuning: the scheduler sends
# while holding the row's FOR UPDATE lock, so an unbounded send pins a locked row
# for as long as a provider stays silent. Max 60.
SMTP_TIMEOUT_SECONDS=10
# Quiet hours, as local wall-clock hours in the CONTRACT's own time zone
# (Contract.timezone), never UTC — 08:00 has to mean 08:00 where the customer is.
# Half-open [start, end), wrapping past midnight when START > END (20 -> 8 here).
# END must differ from START: a zero-length window would read as "configured"
# while switching the rule off, so startup refuses that pair.
# A dispatch inside the window is DEFERRED (scheduled_at moves to the opening),
# never refused, and the send path is not reached.
QUIET_HOURS_START=20
QUIET_HOURS_END=8
# Dispatch attempts before a row is parked `failed` for an operator — the same
# bound OUTBOX_MAX_ATTEMPTS plays for a parked event row.
# Floor is 1, not 0: the budget is checked BEFORE the transport is reached, so 0
# would park every row on its first attempt and make a send impossible.
NOTIFICATION_RETRY_MAX=3
# Rows the scheduler (python -m app.workers.notification_scheduler) claims per
# tick, and how long it waits after draining the due queue. Each row is its own
# transaction, so BATCH_SIZE bounds one tick's work, not a lock hold.
# Keep the interval well under a minute: a row deferred by quiet hours resumes
# only when its window opens, and this is how promptly that gets noticed.
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_POLL_INTERVAL_SECONDS=5

# --- attention check (gap 22's residue) -------------------------------------
# The scheduled form of `python -m app.cli doctor`: it reads the three tables that
# hold states nobody is told about — parked outbox events, failed/suppressed
# notifications, and field values still stored in plaintext — and logs one verdict.
# It writes nothing and exits 0 for a finding, because its container would otherwise
# crash-loop and bury the line that says what is wrong.
#
# Five minutes, not five seconds: these states do not become more urgent between
# ticks, and each tick reads three tables.
ATTENTION_POLL_INTERVAL_SECONDS=300
# Rows scanned for unsealed values per check. A full page makes the reported count a
# floor rather than the table's total, which the report admits instead of rounding
# away. Matches `doctor --limit`'s default so a scheduled check and a hand run agree.
ATTENTION_FIELD_SCAN_LIMIT=500
# Where a *change* of verdict is mailed. Empty (the default) keeps it in the log,
# which is what this worker did before the address existed.
#
# It mails the OPERATOR, not a customer: the recipient is deployment configuration,
# so no tenant principal is involved and the cross-tenant counts in the report never
# have to be scoped to one. That is why this worked where an HTTP route could not.
#
# One message when a finding appears, one when the board clears, silence in between —
# a standing finding would otherwise be 288 mails a day at the default interval.
# Sent through the NOTIFICATION_TRANSPORT=smtp relay above; setting this address with
# any other transport is refused at start-up rather than at the first finding.
ATTENTION_ALERT_TO=

# --- escalation (gap 15) ----------------------------------------------------
# Two different clocks, deliberately separate. SLA_HOURS is how long a raised
# escalation has before it is late (Q2: 48 h, counted from the moment it was
# raised, not from the reminder before it). NO_RESPONSE_DAYS is how long a
# contract may sit silent after the last accepted contact before a human is
# handed it at all. Collapsing them would escalate on day two.
ESCALATION_SLA_HOURS=48
ESCALATION_NO_RESPONSE_DAYS=14
# Rows the scanner (python -m app.workers.escalation_scanner) claims per tick,
# and the wait between passes. Unlike the notification scheduler, the batch is
# ONE transaction — the claim and the writes it authorises must share a lock —
# so BATCH_SIZE bounds how long row locks are held, not just one tick's work.
# The window measured is fourteen DAYS, so a sweep finer than minutes would add
# load without finding anything sooner.
ESCALATION_SCAN_BATCH_SIZE=50
ESCALATION_SCAN_POLL_INTERVAL_SECONDS=300

# Where a NEWLY RAISED escalation is mailed. Empty means log-only, and that is the
# default for the same reason ATTENTION_ALERT_TO is: an address nobody reads is
# worse than no address, because it lets an operator believe a person is being
# told. One mail per pass that raised something, never one per escalation — a pass
# that opens fifty is one event to act on, not fifty messages that bury each other.
#
# The recipient is the deployment's operator, never the customer. What raises an
# escalation is that the customer could not be reached, so the party able to act is
# whoever runs this. The message therefore carries ids and an SLA deadline and no
# contact value of any kind at all: mail is not a channel this project treats as
# safe for customer PII, and no consent gate applies because we are mailing
# ourselves, not the customer.
ESCALATION_ALERT_TO=

# --- http ------------------------------------------------------------------
# Comma-separated, explicit origins only. '*' is rejected at startup.
CORS_ORIGINS=http://localhost:3000
