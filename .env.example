# ============================================================
# APPLICATION
# ============================================================
APP_NAME=contract-agent
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ============================================================
# API
# ============================================================
API_V1_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# SECURITY / JWT
# ============================================================
JWT_SECRET_KEY=change-me-to-a-64-char-random-string-in-prod-please-xxxxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# ENCRYPTION (Fernet — 32-byte base64)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================
ENCRYPTION_KEY=

# ============================================================
# SECRETS PROVIDER
# ============================================================
SECRETS_PROVIDER=env
# SECRETS_PROVIDER=aws | azure | env

# ============================================================
# DATABASE (MySQL 8)
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=contract
MYSQL_PASSWORD=contract
MYSQL_DB=contract_agent
MYSQL_POOL_SIZE=10
MYSQL_POOL_RECYCLE=3600

# ============================================================
# REDIS (refresh token blacklist, rate limit, idempotency)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# KAFKA / STRIKEMQ
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=contract-agent
KAFKA_CONSUMER_GROUP=contract-agent-cg
KAFKA_ENABLED=false
KAFKA_TOPIC_CONTRACT_INGESTED=contract.ingested
KAFKA_TOPIC_FIELDS_EXTRACTED=fields.extracted
KAFKA_TOPIC_NOTIFICATION_SENT=notification.sent
KAFKA_TOPIC_CUSTOMER_RESPONDED=customer.responded
KAFKA_TOPIC_ESCALATION_TRIGGERED=escalation.triggered

# ============================================================
# MLFLOW
# ============================================================
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_EXTRACTION=extraction-quality
MLFLOW_EXPERIMENT_AGENT=agent-decisions
MLFLOW_EXPERIMENT_VOICE=voice-amd

# ============================================================
# OBSERVABILITY
# ============================================================
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=contract-agent
PROMETHEUS_ENABLED=true

# ============================================================
# MULTI-TENANCY
# ============================================================
TENANT_DEFAULT_ID=00000000-0000-0000-0000-000000000001
TENANT_ENFORCE=true

# ============================================================
# EXTRACTION
# ============================================================
EXTRACT_CONFIDENCE_THRESHOLD=0.80
EXTRACT_MAX_FILE_SIZE_MB=10
EXTRACT_STORAGE_DIR=./data/raw
SKIP_VIRUS_SCAN=true

# ============================================================
# LLM / AGENT (Ollama)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:1.5b
LLM_MOCK=true
AGENT_ENABLED=false
PROMPT_AB_SPLIT=0.0

# ============================================================
# SMS (textbee)
# ============================================================
TEXTBEE_BASE_URL=http://localhost:3001
TEXTBEE_API_KEY=dev-key
TEXTBEE_DEVICE_ID=dev-device
TEXTBEE_WEBHOOK_SECRET=dev-webhook-secret
SMS_MOCK=true

# ============================================================
# EMAIL (smtp4dev local)
# ============================================================
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@contract-agent.local
SMTP_TLS=false
EMAIL_MOCK=true

# ============================================================
# VOICE
# ============================================================
VOICE_ENABLED=false
VOICE_MOCK=true
VOICE_PROVIDER=pyvoip
VOICE_RECORDING_DIR=./data/voice
VOICE_RECORDING_RETENTION_DAYS=90

# ============================================================
# SCHEDULING
# ============================================================
SCHEDULE_ENABLED=false
SCHEDULE_CRON_HOUR_UTC=3
SCHEDULE_OFFSETS_DAYS=60,30,14

# ============================================================
# ESCALATION
# ============================================================
ESCALATION_RESPONSE_WINDOW_DAYS=14
ESCALATION_OPERATOR_EMAIL=ops@contract-agent.local

# ============================================================
# COMPLIANCE
# ============================================================
GDPR_HARD_DELETE_AFTER_DAYS=30
RETENTION_CONTRACTS_YEARS=7
RETENTION_AUDIT_YEARS=2
RETENTION_NOTIFICATIONS_YEARS=1

# ============================================================
# DNC (TCPA)
# ============================================================
DNC_ENABLED=false
DNC_API_URL=
DNC_LOCAL_CSV=./data/dnc.csv

# ============================================================
# RATE LIMIT
# ============================================================
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_WEBHOOK_PER_MIN=100

# ============================================================
# FEATURE FLAGS
# ============================================================
FEATURE_VOICE_CHANNEL=false
FEATURE_AI_AGENT=false
FEATURE_AB_PROMPTS=false
