# Copy to .env and adjust. Never commit a real .env.
# Every value below is read once by app.core.config.Settings, which fails fast
# when a value is missing, malformed, or unsafe for the chosen APP_ENV.

# --- runtime ---------------------------------------------------------------
APP_ENV=development
APP_NAME=contract-expiry-notification-agent
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# Leave blank to default from APP_ENV (JSON in staging/production).
# `false`, not empty. `Settings.log_json` is a `bool`, and pydantic refuses to parse
# an empty string into one, so the `cp .env.example .env` that `docker compose` needs
# produced a file nothing could load — every `Settings()` raised before any test ran
# (`D10-114` measured it). `false` is the value compose already interpolated.
#
# A `.env` beside this example used to reconfigure the test suite, because pytest
# runs from the same root `docker compose` reads it from and `Settings` honours the
# file. `D10-115` measured seven failures that way, in two files, from values no
# test had passed, and closed it in the suite instead of here: `conftest` switches
# the file off for the test run. This example stays a subject of `test_config`,
# which loads it by name — so a line that cannot be parsed fails a test rather than
# waiting for someone to copy the file and try to boot.
LOG_JSON=false

# --- security --------------------------------------------------------------
# Must be >= 32 chars and must NOT be this placeholder in staging/production.
SECRET_KEY=dev-only-insecure-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# 32-byte url-safe base64 value. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Set rather than left empty, because the extractor builds its cipher at start-up: an
# empty value there is a container that never finishes coming up, which reads as a
# broken stack rather than as a missing key. This value is 32 zero bytes, so it reads
# as filler at a glance, and staging/production refuse it. A readable sentence encoded
# to base64url is *not* filler by a scanner's measure: base64 spreads the bits, so it
# measures 4.77 bits per character and `generic-api-key` flags it in history.
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Keys this installation used before the current one: comma-separated, oldest
# first, at most 4. They are decrypt-only, so they exist to make rotating
# ENCRYPTION_KEY survivable rather than to be kept forever. Rotation:
#   1. move the old key here and put the new one in ENCRYPTION_KEY
#   2. restart, then run: python -m app.cli reseal-fields
#   3. when its log says rewrapped=0, clear this variable and restart again
# Empty is the steady state. Setting it without ENCRYPTION_KEY is refused at
# startup, because nothing would be able to seal the rows being re-wrapped.
ENCRYPTION_KEY_PREVIOUS=
# Argon2id cost. The defaults meet argon2-cffi's recommendation and exceed the
# OWASP minimum (19 MiB, t=2, p=1). Lowering them weakens every stored password
# hash, so change them only to climb.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
# Login admission control. Failed logins are counted per (tenant slug, email)
# digest inside a sliding window; once LOGIN_MAX_ATTEMPTS failures sit in that
# window the next attempt is refused with 429 + Retry-After *before* any password
# hashing, so a flood costs a SHA-256 and a count instead of an Argon2id run.
# 5 failures in 900s is the intended posture: room for a mistyped password, too
# few to be a useful guessing oracle. Raising the count or shortening the window
# widens the guess budget; shrinking either locks a legitimate user out for up to
# one window. The counters live in MySQL (no Redis), one row per failure.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- local database (docker-compose.yml, not Settings) ----------------------
# None of these is a setting: `Settings` never reads them and no field declares
# them, which is why `test_config` lists them as compose-only keys. They are here
# because `docker-compose.yml` interpolates them — and the two passwords are
# written `${MYSQL_ROOT_PASSWORD:?set MYSQL_ROOT_PASSWORD in .env}`, which is a
# refusal rather than a default. Compose stops before it builds an image or starts
# a container, and its message names a variable this file never offered a line for.
#
# So `cp .env.example .env` loaded the application but could not start the stack:
# `docker compose up` answered with a parse error, and the machine kept the empty
# container list that reads exactly like a stack nobody had asked for. The copy is
# the step the README and this file both point at, so it has to be a stack that
# starts, not only a file that boots.
#
# Development values only, like SECRET_KEY above; a deployment sets its own.
MYSQL_DATABASE=contract_agent
MYSQL_USER=contract_agent
MYSQL_PASSWORD=contract-agent-dev-password
MYSQL_ROOT_PASSWORD=contract-agent-dev-root-password
# Host port MySQL publishes on, loopback only. Change it when 3306 is taken; the
# container's own port is always 3306, and the value is read by the port mapping
# rather than by any application code.
MYSQL_PORT=3306

# --- infrastructure --------------------------------------------------------
# Host-side only: `docker-compose.yml` overrides this inside every container, where
# the database is `mysql:3306` with the credentials above, never `localhost`.
DATABASE_URL=mysql+pymysql://app:app@localhost:3306/contracts
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OLLAMA_BASE_URL=http://localhost:11434
# Which transport the outbox relay publishes through: none | kafka.
# `none` keeps the refusing stand-in, so events retry and then park as failed
# instead of being silently dropped — nothing is ever logged and dropped. Only
# the relay process reads this; the API never publishes. The publish timeout
# must stay below OUTBOX_LEASE_SECONDS (validated at startup).
EVENT_TRANSPORT=none
KAFKA_CLIENT_ID=contract-agent-outbox-relay
KAFKA_PUBLISH_TIMEOUT_SECONDS=10
KAFKA_PRODUCE_RETRIES=3

# --- readiness (F5) --------------------------------------------------------
# Upper bound, in seconds, on one dependency check in GET /health/ready.
# Liveness (/health) touches nothing and never uses this. It also bounds the
# Kafka admin client's request timeout: a blocked worker thread cannot be
# cancelled from outside, so the probe has to give up on its own.
READINESS_TIMEOUT_SECONDS=2

# --- extraction (F7) -------------------------------------------------------
# Which backend reads field values out of a contract document: pattern | ollama.
# `pattern` is deterministic and offline (labelled regexes). `ollama` sends the
# document text to the local model named below. There is no cloud option: "no
# cloud LLM" is a non-negotiable, so the setting cannot even name one.
EXTRACTION_BACKEND=pattern
EXTRACTION_MODEL=llama3.1:8b
EXTRACTION_TIMEOUT_SECONDS=30
# At or above this confidence a field may skip human review (0 < t <= 1). Below
# it the field is written `pending_review` and blocks the notification pipeline.
# No setting can make extraction write `approved`: only a person can.
EXTRACTION_REVIEW_THRESHOLD=0.8
# Upper bound, in characters, on the document text handed to a backend.
EXTRACTION_MAX_DOCUMENT_CHARS=20000

# --- contract documents (gap 12) -------------------------------------------
# Where uploaded document bytes are kept. Documents are sealed with
# ENCRYPTION_KEY before they are written — a PDF holds every field on the page at
# once, so a document in the clear would undo the encryption of extracted values.
# Keys are content-addressed (`<sha256[:2]>/<sha256>`), so re-uploading a file is
# one blob rather than a second copy.
# Relative is accepted in development only; staging and production must name an
# absolute path. The API, the workers and an operator's CLI do not share a
# working directory, and a disagreement there appears as a stored document that
# cannot be found.
#
# Deliberately left unset here (D10-127). Two consumers read this one file and
# they want two different answers: a checkout on the host wants the bytes beside
# it, and `docker compose` hands the same value to containers whose root
# filesystem is read-only, where a relative path resolves under /app and the first
# upload dies with `Read-only file system: '/app/var'` — a 500 on every upload,
# not a first-boot failure. Left unset, each consumer gets its own default:
# Settings() falls back to `var/documents`, and docker-compose.yml falls back to
# the absolute path it mounts a volume at. Naming either value here breaks the
# other.
#   DOCUMENT_STORE_PATH=var/documents                  # Settings()'s own default
#   DOCUMENT_STORE_PATH=/var/lib/contract-agent/documents  # what the stack mounts
# Largest document accepted, in bytes (at most 100 MiB — 104857600).
# This bounds what is sealed and stored, not the memory FastAPI has already used
# to read the request body; a proxy's own body limit is the only thing that can
# bound that.
DOCUMENT_MAX_BYTES=10485760

# --- document scanning (P2-A) -----------------------------------------------
# Whether an uploaded document is examined by ClamAV before it is sealed.
# `none` is not a verdict: an unscanned document is unexamined, not clean, and
# the upload route stores it exactly as it always did. Switch to `clamd` to have
# every upload refused unless a daemon call answers with a clean verdict.
#
# The conversation with clamd is plain text over TCP with no authentication, so
# Settings refuses to start when CLAMD_HOST is written out as a *public*
# address — that would send a customer's contract in clear text to a daemon
# anyone can answer for. A hostname is not resolved here, so a Compose service
# name or a private address is what a deployment should use.
VIRUS_SCAN_TRANSPORT=none
CLAMD_HOST=127.0.0.1
# clamd's TCP port (the default in its own configuration).
CLAMD_PORT=3310
# Upper bound on one socket operation, not on the whole scan (at most 300). It
# is also the worst case this adds to a single upload's latency: the scan runs
# inside the request, not in a worker.
CLAMD_TIMEOUT_SECONDS=30

# --- pull-mode ingestion (P2-H, D10-143) ------------------------------------
# The one route where this API opens an outbound connection: POST
# /api/v1/contracts/pull names a company API and imports what it answers. The
# caller chooses the destination, so the bounds below are part of the security
# rather than tuning: a pull reaches a public https address only — no private or
# link-local hosts, no redirects, no plain http.
#
# PULL_ALLOW_PRIVATE_HOSTS is the local-double escape hatch. It lifts the address
# rule so a test can point a pull at 127.0.0.1, and Settings refuses to start with
# it enabled outside development and test: with it on, an operator could aim a
# pull at this deployment's own metadata service or a sidecar and read the answer
# back in an error message.
# One fetch's wall-clock limit, in seconds (at most 60).
PULL_TIMEOUT_SECONDS=10
# Largest source body accepted, in bytes (at most 20 MiB). Bounds what is read,
# not the memory already used to buffer it.
PULL_MAX_BYTES=1048576
# Most contracts one pull may carry (at most 1000). A pull commits as a single
# transaction, so this is what keeps one request from holding a large write open.
# Page the source rather than raise it.
PULL_MAX_CONTRACTS=100
# Development and tests only. Never enable this in staging or production.
PULL_ALLOW_PRIVATE_HOSTS=false

# --- notification dispatch (F10) -------------------------------------------
# Which transport delivers E-MAIL: none | smtp. SMS has its own switch
# (SMS_TRANSPORT, below) rather than being a third member here, so a deployment can
# deliver one channel, both, or neither without a channel riding another's transport.
# `none` wires a refusing stand-in, so a dispatch records the attempt and fails
# visibly (409 SENDER_UNAVAILABLE) instead of marking a row `sent` with nothing
# delivered. `smtp` selects the e-mail adapter. SMS and voice each carry their own
# switch below (SMS_TRANSPORT, VOICE_TRANSPORT) for the same reason: no channel rides
# another channel's transport, so a voice reminder that arrived as an e-mail is
# refused rather than delivered.
NOTIFICATION_TRANSPORT=none
# --- SMTP, read only when NOTIFICATION_TRANSPORT=smtp ----------------------
# A normal return from a send means the relay ACCEPTED the message (its 250 to
# DATA), not that it was delivered: bounces arrive later and are not handled yet.
# SMTP_HOST and SMTP_FROM are required for `smtp`; missing either is a startup
# error rather than a failure discovered inside the scheduler's row lock.
SMTP_HOST=
# 587 is the submission port and expects STARTTLS. Port 465 (implicit TLS) is
# deliberately unsupported: it needs SMTP_SSL before the first byte, so both
# shapes behind one transport name is a setting deployments get wrong once.
SMTP_PORT=587
# The envelope sender (MAIL FROM / From:). A plain address — no display name.
SMTP_FROM=
# Optional, but both or neither: a relay that wants credentials needs the pair.
SMTP_USERNAME=
SMTP_PASSWORD=
# Refused as `false` in staging/production: without TLS the credentials and the
# recipient address cross the network in clear text.
SMTP_STARTTLS=true
# Path to a PEM bundle of CAs to trust INSTEAD of the system trust store. Needed
# for an internal relay with a private CA; leave empty to use the system store.
# It never disables verification: the client always checks the relay's certificate
# and hostname. Boot errors, not first-send failures, for a path that is missing,
# for a file `ssl` cannot parse (empty or truncated), and for a bundle set while
# SMTP_STARTTLS=false — a CA that is never consulted would read as "TLS on".
SMTP_CA_BUNDLE=
# Ceiling on one SMTP conversation (connect, TLS, auth, DATA), applied to the
# socket by smtplib. This is a correctness bound, not tuning: the scheduler sends
# while holding the row's FOR UPDATE lock, so an unbounded send pins a locked row
# for as long as a provider stays silent. Max 60.
SMTP_TIMEOUT_SECONDS=10
# --- SMS, read only when SMS_TRANSPORT=textbee -----------------------------
# Refused at start-up in staging and production unless INBOUND_TRANSPORT=textbee is
# also set. A customer who cannot stop the messages has not consented to them: an SMS
# with no way to withdraw is an unsolicited message rather than a smaller notification.
# Listening is therefore a precondition of SENDING here, not of the adapter existing —
# development stays open either way so the gateway can be exercised against a local
# double.
SMS_TRANSPORT=none
# The gateway credential. Never logged, never returned by a route, and kept out of
# the adapter's repr. Required with the device id when SMS_TRANSPORT=textbee:
# missing either is a start-up error, not a failure inside the scheduler's row lock.
TEXTBEE_API_KEY=
# Which gateway device sends. It is a path segment of the request URL, so a wrong
# value is a 404 at the first send — hence the start-up refusal.
TEXTBEE_DEVICE_ID=
# The gateway origin. Must be https unless loopback, in EVERY environment: the body
# carries the customer's number and the header carries the key. Stricter than the
# OLLAMA_BASE_URL rule on purpose — that one guards a feature vector. Loopback stays
# allowed so a local double can be pointed at without a certificate.
TEXTBEE_BASE_URL=https://api.textbee.dev
# Ceiling on ONE gateway call: the same correctness bound as SMTP_TIMEOUT_SECONDS,
# because the scheduler sends while holding the row's FOR UPDATE lock. Max 60.
SMS_TIMEOUT_SECONDS=10
# --- voice, read only when VOICE_TRANSPORT=ari ------------------------------
# A third switch, for the reason SMS_TRANSPORT is one: sending and hearing are
# separate capabilities, and no channel rides another channel's transport. `ari`
# selects a dialler over the Asterisk REST Interface, which ORIGINATES the call.
#
# What it does not do is hear the answer. Whether a human or an answering machine
# picked up, and what the call actually said, belongs to a Stasis application that
# answers the channel — a component this build does not contain. So `ari` on its own
# buys a channel that is created and a row that records the attempt; alone it is not
# evidence that the customer was reached. What can make it evidence is
# VOICE_OUTCOME_SECRET, further down: with it set, the dialplan reports what
# Asterisk's own AMD() decided and the row moves to `answered` or `machine`.
VOICE_TRANSPORT=none
# The ARI origin, e.g. https://asterisk.internal:8088. Must be an absolute URL and
# must be https unless loopback, in EVERY environment: the request carries the
# customer's number and these credentials. Loopback stays allowed because that is
# how a dialler normally reaches Asterisk — as a sidecar, not across a network.
ARI_BASE_URL=
# HTTP Basic credentials. ARI offers no other authentication, so both are required
# when VOICE_TRANSPORT=ari and a missing either is a start-up error. Never logged
# and never returned; the adapter's repr keeps them out.
ARI_USERNAME=
ARI_PASSWORD=
# The dial string the call is originated to: the tech/data half of an ARI endpoint
# (PJSIP/trunk/{number}), not a URL or a phone number. It MUST contain {number} —
# a fixed endpoint would dial the same phone for every reminder and no error would
# ever say so, which is why a template without it is refused at start-up. The
# rendered string holds the customer's number, so it is treated as credential-shaped.
ARI_ENDPOINT=
# The Stasis application the answered channel is handed to — what the call becomes
# once this transport's job ends.
ARI_APP=contract-reminders
# What the customer sees as caller ID. Optional: empty lets Asterisk use the
# endpoint's own number, which is the right default for a single-number trunk.
ARI_CALLER_ID=
# Ceiling on the dial request and on how long the far end may ring — one number for
# both, for the same correctness reason as SMTP_TIMEOUT_SECONDS: the scheduler sends
# while holding the row's FOR UPDATE lock. Max 120.
VOICE_RING_SECONDS=25
# --- call outcomes: the AMD() verdict posted back (P2-F part 2) ----------------
# Whether the dialplan tells this service what its AMD() decided. When set, the
# dialler POSTs {"channel_id": ..., "verdict": ...} to /api/v1/voice/outcome and the
# notification row moves from `sent` to `answered` or `machine`. AMD's NOTSURE and
# DONTCARE are counted in voice_outcome_total and written nowhere, because "we could
# not tell" is not a verdict. Empty -- the default -- leaves that route answering 404
# and voice reminders recorded as placed and nothing more.
#
# Its own secret, deliberately not shared with INBOUND_WEBHOOK_SECRET: the two
# authenticate different callers, and one leaked secret must not grant the other's
# capability. Subject to the same length floor as the inbound secret. Setting it while
# VOICE_TRANSPORT is not `ari` is a start-up error rather than a warning: nothing would
# ever post to it, so the route would answer 202 to nobody and look healthy doing it.
VOICE_OUTCOME_SECRET=
# --- inbound SMS: the STOP webhook (used only when INBOUND_TRANSPORT=textbee) ---
# Whether this deployment can READ a customer's reply. A separate switch from
# SMS_TRANSPORT because sending and hearing are separate capabilities, and the pairing
# that matters is one-way: staging and production refuse to SEND to a customer they
# cannot hear (see above), while a deployment may listen and never send.
# `none` mounts no route at all, so the endpoint answers 404 and a scanner cannot tell
# "SMS is not configured here" from "this service has no such endpoint".
INBOUND_TRANSPORT=none
# The secret the gateway signs webhook bodies with; X-Signature is
# hex(HMAC-SHA256(secret, raw body)). Required with INBOUND_TRANSPORT=textbee, minimum
# 32 characters, and never defaulted. This endpoint is reachable by anyone who can
# reach the app, and the signature is the only thing separating the gateway from a
# stranger who guessed a phone number — a wrong guess is answered by the same 202 a
# right one gets, so an attacker learns nothing per attempt. Blank is a start-up
# refusal, never an "unsigned is acceptable" default.
INBOUND_WEBHOOK_SECRET=
# The key behind the contact blind index: a keyed HMAC-SHA256 of the normalised
# phone/email, stored beside the encrypted value so an inbound number can find the
# contract it means. Contact columns are Fernet ciphertext under a random IV — the same
# number encrypts to different bytes every time — so nothing else could make that match.
#
# Deliberately NOT derived from ENCRYPTION_KEY: that key is rotated (it carries a
# retired-key ring), and a rotation would change every digest at once, orphaning every
# stored opt-out in a single step. Separate key, separate lifetime: rotating this one
# needs a `backfill-blind-index` run, which is why that command only fills NULL digests.
#
# Required whenever INBOUND_TRANSPORT=textbee, and required by the extraction worker at
# start-up whatever the transport says: that worker builds its index before it reads a
# document, because a stored contact value with no digest is one an inbound STOP could
# never find. So the stack below needs a value even on a deployment that listens to
# nothing, and an absent key is legal only for the processes that never index.
#
# Omitted entirely (rather than set to an empty value) is still the shape for "this
# deployment has no inbound lookup": an absent key says exactly that, while a blank one
# says the same lie an operator would rather believe, so start-up refuses it. The value
# below is the example's own dev key — visibly not key material — and staging/production
# refuse it the same way they refuse the SECRET_KEY placeholder. `backfill-blind-index`
# fills digests for contact rows written while this was unset.
CONTACT_BLIND_INDEX_KEY=not-a-credential-dev-blind-index-key
# Quiet hours, as local wall-clock hours in the CONTRACT's own time zone
# (Contract.timezone), never UTC — 08:00 has to mean 08:00 where the customer is.
# Half-open [start, end), wrapping past midnight when START > END (20 -> 8 here).
# END must differ from START: a zero-length window would read as "configured"
# while switching the rule off, so startup refuses that pair.
# A dispatch inside the window is DEFERRED (scheduled_at moves to the opening),
# never refused, and the send path is not reached.
QUIET_HOURS_START=20
QUIET_HOURS_END=8
# Dispatch attempts before a row is parked `failed` for an operator — the same
# bound OUTBOX_MAX_ATTEMPTS plays for a parked event row.
# Floor is 1, not 0: the budget is checked BEFORE the transport is reached, so 0
# would park every row on its first attempt and make a send impossible.
NOTIFICATION_RETRY_MAX=3
# Rows the scheduler (python -m app.workers.notification_scheduler) claims per
# tick, and how long it waits after draining the due queue. Each row is its own
# transaction, so BATCH_SIZE bounds one tick's work, not a lock hold.
# Keep the interval well under a minute: a row deferred by quiet hours resumes
# only when its window opens, and this is how promptly that gets noticed.
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_POLL_INTERVAL_SECONDS=5

# --- attention check (gap 22's residue) -------------------------------------
# The scheduled form of `python -m app.cli doctor`: it reads the three tables that
# hold these states across every tenant — parked outbox events, failed/suppressed
# notifications, and field values still stored in plaintext — and logs one verdict.
# It writes nothing and exits 0 for a finding, because its container would otherwise
# crash-loop and bury the line that says what is wrong.
#
# It is not the only reader, and this line is not the only alarm. `GET /api/v1/attention`
# serves an admin their own failed/suppressed and unsealed counts, and since D10-117 and
# D10-118 the park and notification states are gauges the shipped rules page on. What
# this line alone provides is the deployment-wide reading — every tenant at once, parks
# included, which that route deliberately omits — and a suppressed notification named
# aloud without paging a deployment for obeying its own policy.
#
# Five minutes, not five seconds: these states do not become more urgent between
# ticks, and each tick reads three tables.
ATTENTION_POLL_INTERVAL_SECONDS=300
# Rows scanned for unsealed values per check. A full page makes the reported count a
# floor rather than the table's total, which the report admits instead of rounding
# away. Matches `doctor --limit`'s default so a scheduled check and a hand run agree.
ATTENTION_FIELD_SCAN_LIMIT=500
# Where a *change* of verdict is mailed. Empty (the default) keeps it in the log,
# which is what this worker did before the address existed.
#
# It mails the OPERATOR, not a customer: the recipient is deployment configuration,
# so no tenant principal is involved and the cross-tenant counts in the report never
# have to be scoped to one. That is why this worked where an HTTP route could not.
#
# One message when a finding appears, one when the board clears, silence in between —
# a standing finding would otherwise be 288 mails a day at the default interval.
# Sent through the NOTIFICATION_TRANSPORT=smtp relay above; setting this address with
# any other transport is refused at start-up rather than at the first finding.
ATTENTION_ALERT_TO=

# --- escalation (gap 15) ----------------------------------------------------
# Two different clocks, deliberately separate. SLA_HOURS is how long a raised
# escalation has before it is late (Q2: 48 h, counted from the moment it was
# raised, not from the reminder before it). NO_RESPONSE_DAYS is how long a
# contract may sit silent after the last accepted contact before a human is
# handed it at all. Collapsing them would escalate on day two.
ESCALATION_SLA_HOURS=48
ESCALATION_NO_RESPONSE_DAYS=14
# Rows the scanner (python -m app.workers.escalation_scanner) claims per tick,
# and the wait between passes. Unlike the notification scheduler, the batch is
# ONE transaction — the claim and the writes it authorises must share a lock —
# so BATCH_SIZE bounds how long row locks are held, not just one tick's work.
# The window measured is fourteen DAYS, so a sweep finer than minutes would add
# load without finding anything sooner.
ESCALATION_SCAN_BATCH_SIZE=50
ESCALATION_SCAN_POLL_INTERVAL_SECONDS=300

# Where a NEWLY RAISED escalation is mailed. Empty means log-only, and that is the
# default for the same reason ATTENTION_ALERT_TO is: an address nobody reads is
# worse than no address, because it lets an operator believe a person is being
# told. One mail per pass that raised something, never one per escalation — a pass
# that opens fifty is one event to act on, not fifty messages that bury each other.
#
# The recipient is the deployment's operator, never the customer. What raises an
# escalation is that the customer could not be reached, so the party able to act is
# whoever runs this. The message therefore carries ids and an SLA deadline and no
# contact value of any kind at all: mail is not a channel this project treats as
# safe for customer PII, and no consent gate applies because we are mailing
# ourselves, not the customer.
ESCALATION_ALERT_TO=

# --- local stack: the Compose relay (D10-116) -------------------------------
# `docker compose up` runs a `mailpit` service — a catch-all SMTP server with a web UI
# on http://127.0.0.1:8025 — so a mail this stack produced can be READ instead of
# inferred from a log line that claims one was sent. Nothing above defaults to it:
# NOTIFICATION_TRANSPORT=none is what lets a fresh checkout run with no relay at all,
# and this stack overriding it would be quietly deciding, for a deployment, whether
# customers receive mail — a decision that belongs to the deployment.
#
# To aim all three mail paths at the local relay, uncomment these and restart the api
# and worker containers:
#
#   NOTIFICATION_TRANSPORT=smtp
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_STARTTLS=false
#   SMTP_FROM=contract-agent@contract-agent.invalid
#   ATTENTION_ALERT_TO=operator@contract-agent.invalid
#   ESCALATION_ALERT_TO=operator@contract-agent.invalid
#
# SMTP_STARTTLS=false is safe ONLY because this is a hop across the Compose network to
# a throwaway catcher that never leaves the machine; staging and production refuse it
# for the reason SMTP_STARTTLS records above. Addresses end in `.invalid` because no
# such domain exists and none of these messages should ever be able to leave.
#
# Alertmanager's receiver is already aimed here in ops/alertmanager/alertmanager.yml,
# so the rule relay needs nothing from this file.

# --- reminder planner -------------------------------------------------------
# The scan that actually produces reminders. Everything above *consumes* a
# notification row; until this worker existed the only thing that wrote one was a
# client calling POST /api/v1/notifications per contract, so "remind 60, 30 and 14
# days before expiry" was kept by hand or not at all.
#
# BATCH_SIZE bounds one *query* and the single transaction wrapped around the page:
# a page commits as a unit and its cursor advances only once it has, so a page that
# fails is re-read whole rather than skipped. A refusal is caught per contract and
# never aborts the page. The interval is five minutes because the milestones it
# measures are measured in days, and a deployment that starts at noon still gets
# its reminders — nothing sleeps waiting for 09:00.
REMINDER_SCAN_BATCH_SIZE=50
REMINDER_SCAN_POLL_INTERVAL_SECONDS=300

# --- contract expiry --------------------------------------------------------
# The other half of the same clock. The planner stops planning once a contract
# leaves its window, but nothing moved the status when the term ran out, so an
# expired file stayed `active` for ever: still counted as live, still chased for a
# reply, still not closed by anyone. This sweep closes it on the customer's own
# calendar day and writes one system-attributed audit row naming the date and the
# zone that closed it.
#
# Hourly, not five-minutely: the event it looks for happens once per contract on a
# day boundary, so the interval also bounds how late a status can be — an hour.
# BATCH_SIZE bounds one query; each genuinely expired row then costs a status write
# and an audit row.
EXPIRY_SWEEP_BATCH_SIZE=50
EXPIRY_SWEEP_POLL_INTERVAL_SECONDS=3600

# --- document extraction (D10-120) ------------------------------------------
# `extract_contract` has been complete since F7, but the only thing that ever
# called it was `python -m app.cli extract` — one contract, by hand. So a contract
# ingested through the API or the document upload route kept its document and never
# grew a field row until somebody remembered to run the command. This worker is the
# clock that was missing; nothing else about extraction became configurable, because
# nothing else about it was ever a choice.
#
# BATCH_SIZE is ten, not the fifty the two scanners use: each row here is a document
# read off the volume, a decrypt and a parse, which is the most expensive per-row work
# any worker in this deployment does. A page is one transaction, and it commits as a
# unit. The interval is fifteen minutes, the longest here, because nothing downstream
# is waiting within the hour — a contract is extracted once, ever, and the reminders
# that read the result are planned days before its end date.
EXTRACTION_SCAN_BATCH_SIZE=10
EXTRACTION_SCAN_POLL_INTERVAL_SECONDS=900

# --- http ------------------------------------------------------------------
# Comma-separated, explicit origins only. '*' is rejected at startup.
CORS_ORIGINS=http://localhost:3000

# --- worker metrics (D10-107) -----------------------------------------------
# `GET /metrics` has always existed, but only on the API. `app.core.metrics` keeps
# its families in a module-level list, so every process has its own copy, and the
# API's copy has never seen a worker's work: `escalations_total`,
# `reminder_plans_total`, `contracts_expired_total` and the worker half of
# `notifications_sent_total` are incremented in processes that served no listener.
# A series no target exposes is a series no alert rule can read — `D10-91` names
# `escalation_email_failed_total` precisely so `increase(...[1h]) > 0` would need no
# rewrite, and it had nothing to read.
#
# So each worker serves its own copy here. Loopback by default: a listener nobody
# asked for should not be reachable off the host. docker-compose.yml overrides the
# host to 0.0.0.0 per worker (inside a container the container is the network
# boundary) and pins the port at 9101, publishing a distinct host port per service.
#
# A worker that runs by hand beside another one needs a distinct value for each —
# six processes sharing one loopback cannot all bind 9101.
WORKER_METRICS_HOST=127.0.0.1
# 0 closes the listener, and that is honest for a deployment that scrapes nothing.
# Any other value is the port to bind. A port already in use is a start-up failure
# rather than a warning: a worker that runs without the listener it was told to have
# is the bug this setting exists to fix. Nothing aggregates across these scrapes —
# a scrape of the relay declares `escalations_total` and emits no sample for it,
# because the relay never increments it: an absent series, which Prometheus reads
# as "no data" rather than as `0`, and still not a reason to sum them.
WORKER_METRICS_PORT=9101

# --- prometheus (D10-111) ----------------------------------------------------
# The host port for `ops/prometheus/prometheus.yml`, which scrapes the API and all
# six worker listeners and loads the escalation alert rule. Loopback only, like the
# worker ports above: the scraper is for this machine, and `PROMETHEUS_PORT=9090` is
# what `docker compose up prometheus` publishes.
#
# Set it only when 9090 is taken. Nothing in the application reads this value — the
# stack's own network reaches Prometheus by service name, and the config names
# targets by container name, so a change here moves the web UI and nothing else.
PROMETHEUS_PORT=9090

# --- grafana (D10-155) --------------------------------------------------------
# The host port for the provisioned dashboards at `ops/grafana`. Loopback only, like the
# scraper's: the panels name queue depths and contract counts, and nothing in the
# application reads this value — the container always serves on 3000.
GRAFANA_PORT=3001

# Required by `docker-compose.yml`, which writes it `${GRAFANA_ADMIN_PASSWORD:?…}`: an
# empty value refuses to start rather than serving the well-known `admin` password with a
# warning nobody reads. The value below is a local default and is not a secret for any
# deployment — the port is loopback, anonymous access is off, sign-up is off, and the
# account can only read dashboards that are provisioned from files it cannot write.
GRAFANA_ADMIN_PASSWORD=local-grafana-admin

# --- frontend (D10-128) -------------------------------------------------------
# The host port the `frontend` service publishes, loopback only. Nothing in the
# application reads it: the container always serves on 3000, and this value is read
# by the port mapping rather than by any code.
#
# It also has to be the origin the API is asked to accept. CORS_ORIGINS above names
# `http://localhost:3000`; change this port and the browser's origin changes with
# it, so the API refuses the request until that line moves too. In the stack as
# shipped it does not matter — the Next server forwards `/api/:path*` to the API
# itself, so the browser only ever calls this origin — but a deployment that publishes
# the API directly and points a browser at it does need the pair to agree.
FRONTEND_PORT=3000
