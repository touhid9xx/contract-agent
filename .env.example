# Copy to .env and adjust. Never commit a real .env.
# Every value below is read once by app.core.config.Settings, which fails fast
# when a value is missing, malformed, or unsafe for the chosen APP_ENV.

# --- runtime ---------------------------------------------------------------
APP_ENV=development
APP_NAME=contract-expiry-notification-agent
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# Leave blank to default from APP_ENV (JSON in staging/production).
LOG_JSON=

# --- security --------------------------------------------------------------
# Must be >= 32 chars and must NOT be this placeholder in staging/production.
SECRET_KEY=dev-only-insecure-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# 32-byte url-safe base64 value. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# Argon2id cost. The defaults meet argon2-cffi's recommendation and exceed the
# OWASP minimum (19 MiB, t=2, p=1). Lowering them weakens every stored password
# hash, so change them only to climb.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- infrastructure --------------------------------------------------------
DATABASE_URL=mysql+pymysql://app:app@localhost:3306/contracts
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OLLAMA_BASE_URL=http://localhost:11434
# Which transport the outbox relay publishes through: none | kafka.
# `none` keeps the refusing stand-in, so events retry and then park as failed
# instead of being silently dropped — nothing is ever logged and dropped. Only
# the relay process reads this; the API never publishes. The publish timeout
# must stay below OUTBOX_LEASE_SECONDS (validated at startup).
EVENT_TRANSPORT=none
KAFKA_CLIENT_ID=contract-agent-outbox-relay
KAFKA_PUBLISH_TIMEOUT_SECONDS=10
KAFKA_PRODUCE_RETRIES=3

# --- readiness (F5) --------------------------------------------------------
# Upper bound, in seconds, on one dependency check in GET /health/ready.
# Liveness (/health) touches nothing and never uses this. It also bounds the
# Kafka admin client's request timeout: a blocked worker thread cannot be
# cancelled from outside, so the probe has to give up on its own.
READINESS_TIMEOUT_SECONDS=2

# --- extraction (F7) -------------------------------------------------------
# Which backend reads field values out of a contract document: pattern | ollama.
# `pattern` is deterministic and offline (labelled regexes). `ollama` sends the
# document text to the local model named below. There is no cloud option: "no
# cloud LLM" is a non-negotiable, so the setting cannot even name one.
EXTRACTION_BACKEND=pattern
EXTRACTION_MODEL=llama3.1:8b
EXTRACTION_TIMEOUT_SECONDS=30
# At or above this confidence a field may skip human review (0 < t <= 1). Below
# it the field is written `pending_review` and blocks the notification pipeline.
# No setting can make extraction write `approved`: only a person can.
EXTRACTION_REVIEW_THRESHOLD=0.8
# Upper bound, in characters, on the document text handed to a backend.
EXTRACTION_MAX_DOCUMENT_CHARS=20000

# --- http ------------------------------------------------------------------
# Comma-separated, explicit origins only. '*' is rejected at startup.
CORS_ORIGINS=http://localhost:3000
