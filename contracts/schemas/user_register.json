{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "POST /auth/register.",
  "properties": {
    "email": {
      "format": "email",
      "title": "Email",
      "type": "string"
    },
    "full_name": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Full Name"
    },
    "password": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Password",
      "type": "string"
    }
  },
  "required": [
    "email",
    "password"
  ],
  "title": "UserRegister",
  "type": "object"
}
