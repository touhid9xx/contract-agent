# Backend image. Non-root, no build-time secrets, no dev dependencies.
# Build from the repository root:
#   docker build -f Dockerfile.backend -t contract-agent-api .
FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Unprivileged runtime account; the app never needs to write to its own code.
RUN groupadd --system --gid 1001 app \
    && useradd --system --uid 1001 --gid app --no-create-home app

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=app:app backend/app ./app

# The migrations, inside the artifact that needs them (`D10-114`). Before this the
# image could serve requests but never create the database it served them from:
# `backend/migrations` and `backend/alembic.ini` were not copied, so `alembic` in
# the container had no script directory to run and every deployment needed the
# schema made by hand from a checkout that had them. `script_location = migrations`
# in `alembic.ini` resolves against the working directory, which is `/app`, which is
# why these land at the top level rather than under `app/`. Nothing here is written
# at runtime, so the image stays read-only-safe.
COPY --chown=app:app backend/alembic.ini ./alembic.ini
COPY --chown=app:app backend/migrations ./migrations

# The document store (`D10-127`). `docker-compose.yml` mounts a named volume at
# `/var/lib/contract-agent/documents` in every service, and every service runs as
# `app`, but Docker creates a *new* named volume owned by root. The first upload
# therefore died with `PermissionError: [Errno 13] ... documents/f8` even once the
# path was right: a correct path into a directory this account cannot write is
# still a stack that cannot store a document. A named volume is seeded from the
# image path it covers, ownership included, so the directory has to exist here with
# the runtime account's ownership before anything mounts over it.
RUN mkdir -p /var/lib/contract-agent/documents \
    && chown -R app:app /var/lib/contract-agent \
    && chmod 0750 /var/lib/contract-agent /var/lib/contract-agent/documents

USER app
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).read()"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
