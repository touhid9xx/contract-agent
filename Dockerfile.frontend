# Frontend image. Non-root, no build-time secrets, no dev dependencies.
# Build from the repository root:
#   docker build -f Dockerfile.frontend -t contract-agent-frontend .
#
# `D10-128`. Until this file existed the stack had no screen: `frontend/` was
# built by CI, typed, linted and unit-tested, and shipped to nothing. Every
# operator action outside the curl-shaped ones (`review`, `consent`, `users`) was
# a route with a UI in one repository and no deployment in the other, and
# `docker compose up` produced an API nobody was looking at.
#
# Two stages, because only the second one is the artefact: `next build` needs
# TypeScript, ESLint and Tailwind, and a runtime that needs none of them should
# not carry them. What crosses between the stages is `output: "standalone"`
# (`frontend/next.config.ts`) — `next build` traces the modules each route
# actually reaches and writes a `server.js` that imports only those — which is
# why the runtime stage installs nothing at all.
FROM node:22-slim AS build

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# The lockfile before the source, so editing a component does not re-resolve the
# dependency tree. `.dockerignore` already keeps `frontend/node_modules` and
# `frontend/.next` out of the context, so this `npm ci` is the only one.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# The rewrite target in `frontend/next.config.ts` is resolved *here*, not when a
# request is served: `next build` evaluates the config and writes the destination
# into `.next/routes-manifest.json`, and the standalone server replays that file.
# Measured, not assumed — a container whose `environment:` named `http://api:8000`
# still proxied to `127.0.0.1:8000` and logged `ECONNREFUSED`, because the build had
# been given no value and taken the fallback. So the address is a build input, and
# the only place to change it is `build.args` in `docker-compose.yml` (followed by
# `docker compose build frontend`). It is not repeated in the runtime stage: an
# `ENV` there would look like it did something and would not.
#
# The default is the address the API has *inside the Compose network*, so a plain
# `docker build -f Dockerfile.frontend .` produces the image the stack expects;
# `next.config.ts` keeps its own `127.0.0.1` fallback for `next dev` on a laptop.
ARG API_PROXY_URL=http://api:8000
ENV API_PROXY_URL=${API_PROXY_URL}

RUN npm run build

FROM node:22-slim AS runtime

# `HOSTNAME=0.0.0.0` is load-bearing, not decoration: the standalone server binds
# `localhost` unless told otherwise, and a container listening only on its own
# loopback is unreachable from the Compose network — every screen would answer
# 502 through a process that reports itself healthy.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app

# The same unprivileged account, uid and gid as `Dockerfile.backend`, so whoever
# reads either file meets one answer to "who runs this stack".
RUN groupadd --system --gid 1001 app \
    && useradd --system --uid 1001 --gid app --no-create-home app

# `standalone` holds `server.js`, the traced `node_modules` and `.next/server`.
# The static assets are deliberately *not* inside it — `next build` leaves them
# in `.next/static`, and a standalone server without them serves HTML whose every
# script and stylesheet is a 404: the page renders unstyled and no client
# component ever hydrates.
COPY --from=build --chown=app:app /app/.next/standalone ./
COPY --from=build --chown=app:app /app/.next/static ./.next/static

# Nothing here is written at runtime, so the image is `read_only: true`-safe, and
# the only writable path the server may want — an ISR/fetch cache under
# `.next/cache` — is a tmpfs in `docker-compose.yml` rather than a directory here:
# a cache survives a restart or it is not a cache.
USER app

EXPOSE 3000

# `/en` and not `/health`: the proxy rules forward `/health` to the API, so a
# probe aimed there would report this container unhealthy whenever the API is
# down — and a healthcheck drives `restart: unless-stopped`, which restarting a
# web tier cannot repair. This asks the only question the process can answer
# about itself: does a page render?
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3000/en').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server.js"]
